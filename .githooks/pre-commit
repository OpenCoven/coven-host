#!/bin/sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "Commit blocked. Install Gitleaks 8.30.1 or compatible v8 and retry." >&2
    exit 1
fi

if ! "$(git rev-parse --show-toplevel)/.githooks/check-private-paths" diff --cached --quiet --no-renames --diff-filter=ACMT; then
    echo "Commit blocked. Check staged paths for a credential file, keystore or private sync database." >&2
    exit 1
fi

exec gitleaks git --pre-commit --staged --config .gitleaks.toml --ignore-gitleaks-allow --redact=100 --no-banner
